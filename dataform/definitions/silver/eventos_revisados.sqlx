config {
  type: "incremental",
  schema: "silver",
  uniqueKey: ["id_evento"],
  bigquery: { partitionBy: "fecha_llegada", clusterBy: ["id_mensajero"] },
  description: "Reglas: un evento repetido cuenta una vez (vale la primera copia que llegó); uno que llega más de VENTANA días después de ocurrir va a cuarentena; uno que no se puede usar va a cuarentena con su motivo. Incremental: se revisan de nuevo los eventos llegados en la ventana."
}

WITH unicos AS (
    SELECT *, ${comun.fecha_archivo("_archivo_origen")} AS fecha_llegada FROM ${ref("bronze", "eventos")}
    WHERE TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY id_evento ORDER BY _archivo_origen, CAST(_linea AS INT64)) = 1
),
tipados AS (
    SELECT id_evento, id_pedido, id_mensajero, tipo, SAFE_CAST(ocurrido_en AS DATETIME) AS ocurrido_en,
           SAFE_CAST(importe AS NUMERIC) AS importe, importe AS importe_texto, _archivo_origen, fecha_llegada
    FROM unicos
),
revisados AS (
    SELECT *, CASE
            WHEN tipo NOT IN ('entrega', 'rechazo', 'devolucion') THEN 'tipo_desconocido'
            WHEN ocurrido_en IS NULL OR (importe_texto IS NOT NULL AND importe IS NULL) THEN 'dato_invalido'
            WHEN DATE(ocurrido_en) < DATE_SUB(fecha_llegada, INTERVAL ${comun.VENTANA} DAY) THEN 'fuera_de_ventana'
            WHEN id_mensajero NOT IN (SELECT id_mensajero FROM ${ref("silver", "alias_mensajeros")}) THEN 'mensajero_desconocido'
            WHEN id_pedido NOT IN (SELECT id_pedido FROM ${ref("silver", "pedidos_historial")}) THEN 'pedido_desconocido'
            WHEN tipo = 'entrega' AND importe IS NULL THEN 'entrega_sin_cobro'
            WHEN tipo = 'devolucion' AND importe IS NULL THEN 'devolucion_sin_importe'
            WHEN importe <= 0 THEN 'importe_no_positivo'
        END AS motivo
    FROM tipados
)
SELECT r.* EXCEPT (importe_texto, motivo),
       CASE WHEN r.motivo IS NULL AND r.tipo = 'devolucion' AND NOT EXISTS (
                SELECT 1 FROM revisados e WHERE e.id_pedido = r.id_pedido AND e.tipo = 'entrega' AND e.motivo IS NULL)
            THEN 'devolucion_sin_entrega' ELSE r.motivo END AS motivo
FROM revisados r
${when(incremental(), `WHERE r.fecha_llegada >=
    (SELECT DATE_SUB(MAX(fecha_llegada), INTERVAL ${comun.VENTANA} DAY) FROM ${self()})`)}
